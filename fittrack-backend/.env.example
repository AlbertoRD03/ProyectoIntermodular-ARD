# === CONFIGURACIÓN DE BASE DE DATOS ===

# MongoDB - Requerido para la mayoría de funciones
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/nombre-db?retryWrites=true&w=majority
# O local: mongodb://localhost:27017/fittrack
MONGO_URI=mongodb://fittrack:fittrackpass@localhost:27017/fittrack?authSource=admin


# MySQL - Opcional. Desactivado por defecto
ENABLE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fittrack
MYSQL_PORT=3306

# === CONFIGURACIÓN DEL SERVIDOR ===
PORT=3000
NODE_ENV=development

# === AUTENTICACIÓN ===
JWT_SECRET=tu_jwt_secret_muy_seguro_y_largo
JWT_EXPIRE=7d

# === SMTP (para emails) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_app_password

# === OTROS ===
# LOG_LEVEL=info
