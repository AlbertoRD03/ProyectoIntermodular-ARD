# === CONFIGURACIÓN DE BASE DE DATOS ===

# MongoDB - Requerido para la mayoría de funciones
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/nombre-db?retryWrites=true&w=majority
# O local: mongodb://localhost:27017/fittrack
MONGO_URI=mongodb://fittrack:fittrackpass@localhost:27017/fittrack?authSource=admin


# MySQL - Opcional. Desactivado por defecto
ENABLE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fittrack
MYSQL_PORT=3306

# === CONFIGURACIÓN DEL SERVIDOR ===
PORT=3000
NODE_ENV=development
REQUIRE_ONBOARDING=false

# === AUTENTICACIÓN ===
JWT_SECRET=tu_jwt_secret_muy_seguro_y_largo
JWT_EXPIRE=7d

# === SMTP (para emails locales/self-hosted) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_app_password
SMTP_FROM="FitTrack <no-reply@fittrack.local>"

# === EMAIL PROVIDER (recomendado en Vercel) ===
# En hosting serverless/Render suele ser más fiable usar API en vez de SMTP.
# Opciones: brevo | resend. Si Brevo bloquea la IP del servidor, usa Resend.
EMAIL_PROVIDER=brevo
EMAIL_FROM="FitTrack <no-reply@fittrack.local>"
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# === CLOUDINARY (uploads de imágenes) ===
# Crea un "API key" en Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta opcional donde guardar uploads
CLOUDINARY_FOLDER=fittrack

# === PASSWORD RESET ===
# URL del frontend donde existe /reset-password
APP_BASE_URL=http://localhost:3000
# Minutos de validez del enlace
PASSWORD_RESET_EXPIRES_MIN=30

# === OTROS ===
# LOG_LEVEL=info
